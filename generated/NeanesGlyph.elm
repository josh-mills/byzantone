module NeanesGlyph exposing (..)

import Html
import Html.Attributes


{- Generated by `npm run codegen` from byzhtml's SBMuFL glyphnames.json. Do not edit by hand. -}


{-| Render an arbitrary codepoint in the Neanes font. Attributes are added after the `font-neanes` class. -}
glyph : Int -> List (Html.Attribute msg) -> Html.Html msg
glyph codepoint attributes =
    Html.span
        (Html.Attributes.class "font-neanes" :: attributes)
        [ Html.text (String.fromChar (Char.fromCode codepoint)) ]


